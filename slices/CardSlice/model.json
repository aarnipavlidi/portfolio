{
  "id": "card_slice",
  "type": "SharedSlice",
  "name": "CardSlice",
  "description": "CardSlice",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default",
      "imageUrl": "",
      "primary": {
        "title": {
          "type": "StructuredText",
          "config": {
            "label": "title",
            "placeholder": "",
            "allowTargetBlank": true,
            "single": "heading2"
          }
        },
        "subtitle": {
          "type": "StructuredText",
          "config": {
            "label": "subtitle",
            "placeholder": "",
            "allowTargetBlank": true,
            "multi": "paragraph"
          }
        }
      },
      "items": {
        "card_image": {
          "type": "Image",
          "config": {
            "label": "Card Image",
            "constraint": { "width": 350, "height": 219 },
            "thumbnails": []
          }
        },
        "name": {
          "type": "StructuredText",
          "config": {
            "label": "Name",
            "placeholder": "Enter name for current card item.",
            "allowTargetBlank": true,
            "single": "heading3"
          }
        },
        "collection": {
          "type": "Link",
          "config": {
            "label": "Collection",
            "select": "document",
            "customtypes": ["icons_list"]
          }
        },
        "description": {
          "type": "StructuredText",
          "config": {
            "label": "Description",
            "placeholder": "Enter description for current card item.",
            "allowTargetBlank": true,
            "multi": "paragraph"
          }
        },
        "icon": {
          "type": "Link",
          "config": {
            "label": "Icon",
            "select": "document",
            "customtypes": ["heroicon"]
          }
        },
        "button": {
          "type": "Link",
          "config": {
            "label": "Button",
            "select": "document",
            "customtypes": ["button"]
          }
        },
        "label": {
          "type": "Text",
          "config": { "label": "Button Label", "placeholder": "" }
        },
        "href": {
          "type": "Link",
          "config": { "label": "Button Href", "select": "document" }
        }
      }
    }
  ]
}
