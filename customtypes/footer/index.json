{
  "id": "footer",
  "label": "Footer",
  "format": "custom",
  "repeatable": false,
  "status": true,
  "json": {
    "Main": {
      "slogan": {
        "type": "StructuredText",
        "config": {
          "label": "Slogan",
          "placeholder": "Add your current slogan into footer. WIll be shown on right side, with same row as the \"key\" words.",
          "allowTargetBlank": false,
          "multi": "heading3"
        }
      },
      "slogan_keys": {
        "type": "Group",
        "config": {
          "label": "Slogan Keys",
          "fields": {
            "word": {
              "type": "StructuredText",
              "config": {
                "label": "word",
                "placeholder": "Use \"key\" words, which is part of the slogan on same row.",
                "allowTargetBlank": false,
                "single": "paragraph,strong,em"
              }
            }
          }
        }
      },
      "social_icons": {
        "type": "Link",
        "config": {
          "label": "Social Icons",
          "select": "document",
          "customtypes": ["icons_list"]
        }
      }
    }
  }
}
