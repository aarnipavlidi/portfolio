{
  "id": "icons_list",
  "label": "Icons List",
  "format": "custom",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "config": { "label": "Entry Name", "placeholder": "" },
        "type": "UID"
      },
      "collection": {
        "type": "Group",
        "config": {
          "label": "Collection",
          "fields": {
            "name": {
              "type": "Text",
              "config": { "label": "name", "placeholder": "" }
            },
            "icon": {
              "type": "Select",
              "config": {
                "label": "icon",
                "placeholder": "",
                "options": [
                  "tailwindcss",
                  "graphql",
                  "react",
                  "nextjs",
                  "GitHub",
                  "LinkedIn",
                  "Twitter"
                ],
                "default_value": "tailwindcss"
              }
            },
            "href": {
              "type": "Link",
              "config": {
                "label": "href",
                "placeholder": "Optional value for current icon. Can be used for example with social icons, where you want to redirect user into LinkedIn etc.",
                "allowTargetBlank": true,
                "select": null
              }
            }
          }
        }
      }
    }
  }
}
